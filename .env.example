# ==========================================
# PayPilot AI - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# PayPal Sandbox Credentials (Orders v2 API)
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox

# AI Provider Configuration
# Supported AI_PROVIDER values: 'gemini', 'openai', 'fallback'
AI_PROVIDER=fallback
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
